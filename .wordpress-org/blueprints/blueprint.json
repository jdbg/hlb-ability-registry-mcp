{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"phpExtensionBundles": [
		"kitchen-sink"
	],
	"features": {
		"networking": true
	},
	"landingPage": "/wp-admin/options-general.php?page=hlb-ability-registry-mcp",
	"steps": [
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/mcp-adapter/releases/latest/download/mcp-adapter.zip"
			},
			"options": {
				"activate": true,
				"targetFolderName": "mcp-adapter"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "hlb-ability-registry-mcp"
			},
			"options": {
				"activate": true,
				"targetFolderName": "hlb-ability-registry-mcp"
			}
		}
	]
}
